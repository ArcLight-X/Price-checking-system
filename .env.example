# ============================================================
# 复制本文件为 .env 即可生效（.env 已被 .gitignore 忽略）
# 所有项都是可选的，不配置也能跑，只是抓取页数会受限
# ============================================================

# 【可选但强烈建议】B站登录态 Cookie 里的 SESSDATA 字段
# 获取方式：浏览器登录 B站 → F12 打开开发者工具 → Application/应用
#          → Cookies → https://www.bilibili.com → 找到 SESSDATA → 复制「值」
#          注意：只复制值本身，不要带 SESSDATA= 前缀，也不要加引号
# 不配置的后果：B站未登录状态只放行 3 条评论，基本等于抓不到东西
# ⚠️ SESSDATA 是会过期的（登录态失效后接口返回 -101）。
#    填好后运行 npm run check:auth 验证是否生效；失效就重新登录 B站再复制一次
BILI_SESSDATA=

# 【可选】设备指纹 buvid3。留空时程序会自动调 B站接口申领一个，一般不用管
BILI_BUVID3=

# 【可选】SQLite 数据库文件路径（相对于项目根目录），默认 data/bilibili.db
BILI_DB_FILE=data/bilibili.db

# 【可选】两次请求之间的最小间隔（毫秒）。调小会更快但更容易被风控，默认 1200
BILI_REQUEST_INTERVAL_MS=1200

# 【可选】单个请求失败后的最大重试次数，默认 3
BILI_MAX_RETRIES=3

# 【可选】每页评论条数，默认 20（B站主评论接口常用值）
BILI_PAGE_SIZE=20
