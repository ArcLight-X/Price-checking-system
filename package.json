{
  "name": "ex_mall",
  "version": "0.1.0",
  "private": true,
  "description": "B站评论区价格信息采集系统 · 阶段一：抓取某个视频的评论区并存入本地 SQLite 数据库",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "crawl": "node --disable-warning=ExperimentalWarning src/crawl.ts",
    "query": "node --disable-warning=ExperimentalWarning src/query.ts",
    "db:info": "node --disable-warning=ExperimentalWarning scripts/inspect-db.mjs",
    "check:auth": "node --disable-warning=ExperimentalWarning scripts/check-auth.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/comment-selection.test.ts tests/conversation.test.ts tests/extraction-validator.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
