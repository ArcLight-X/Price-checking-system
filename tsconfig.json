{
  // TS 配置只服务于「编辑器提示 + tsc --noEmit 类型检查」，不参与运行时。
  // 真正的运行方式是 Node 24 直接执行 .ts 文件（类型擦除，零构建）。
  "compilerOptions": {
    // 目标语法版本：Node 24 完整支持 ES2023
    "target": "es2023",
    // 可用的内置 API 类型（不含 DOM，因为这是服务端代码）
    "lib": ["es2023"],
    // 模块体系：ESM + Node 的解析规则
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // 允许在 import 里写 .ts 后缀 —— Node 原生跑 TS 时「必须」写后缀
    "allowImportingTsExtensions": true,
    // 只做类型检查、不产出 JS 文件（因此上面那项才允许开启）
    "noEmit": true,
    // 只允许「可被类型擦除」的语法（禁止 enum / namespace / 参数属性 / 装饰器）
    // 这样 tsc 能在编码阶段就拦住 Node 跑不起来的写法
    "erasableSyntaxOnly": true,
    // 强制区分「只导入类型」和「导入值」，避免运行时多余的 import
    "verbatimModuleSyntax": true,
    // 严格模式全家桶
    "strict": true,
    // 数组下标访问也视为可能 undefined，逼着写边界判断，减少线上崩溃
    "noUncheckedIndexedAccess": true,
    // 跳过 node_modules 里第三方包的类型检查，加快检查速度
    "skipLibCheck": true,
    // 允许 import JSON（本阶段没用到，先开着）
    "resolveJsonModule": true,
    // 只加载 Node 的内置类型
    "types": ["node"]
  },
  // 只检查 src 和 scripts 目录下的 TS 文件
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
